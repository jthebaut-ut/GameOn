    "business_review_banner_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir prüfen neue Locations, bevor Eigentümer-Tools freigeschaltet werden, damit FanGeo vertrauenswürdig und korrekt bleibt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We review new venues before owner tools are enabled to help keep FanGeo trusted and accurate."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisamos los nuevos locales antes de activar las herramientas de propietario para mantener FanGeo fiable y preciso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous vérifions les nouveaux établissements avant d’activer les outils propriétaire pour garder FanGeo fiable et exact."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esaminiamo le nuove sedi prima di abilitare gli strumenti proprietario per mantenere FanGeo affidabile e accurato."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weryfikujemy nowe lokale przed włączeniem narzędzi właściciela, aby FanGeo było wiarygodne i dokładne."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analisamos novos locais antes de ativar as ferramentas de proprietário para manter o FanGeo confiável e preciso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мы проверяем новые заведения перед включением инструментов владельца, чтобы FanGeo оставался надёжным и точным."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne rishikojmë vendet e reja përpara se të aktivizohen mjetet e pronarit, për ta mbajtur FanGeo të besueshëm dhe të saktë."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
