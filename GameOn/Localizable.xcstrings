    "Reach local sports fans with business advertising opportunities." : {
      "comment" : "A description of a sponsor inquiry feature.",
      "extractionState" : "manual",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erreichen Sie lokale Sportfans mit Werbemöglichkeiten für Unternehmen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reach local sports fans with business advertising opportunities."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Llegue a los fanáticos de los deportes locales con oportunidades de publicidad comercial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez les amateurs de sport locaux grâce à des opportunités de publicité commerciale."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raggiungi gli appassionati di sport locali con opportunità pubblicitarie aziendali."
