    "notifications_favorite_team_nearby_subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FanGeo benachrichtigt dich, wenn ein Watch Spot in der Nähe eines deiner Teams zeigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FanGeo notifies you when a nearby watch spot is showing one of your teams."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FanGeo te avisa cuando un watch spot cercano muestra uno de tus equipos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FanGeo vous prévient lorsqu’un watch spot à proximité diffuse une de vos équipes."
          }
        },
        "it" : {
          "stringUnit" : {
