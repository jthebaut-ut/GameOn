    "allow_other_fans_to_discover_me_subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ermöglicht FanGeo, dein Profil anderen Fans vorzuschlagen und dich bei Aktivität in die Nähe-Fan-Aktivität einzubeziehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lets FanGeo suggest your profile to other fans and include you in nearby fan activity when you're active."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que FanGeo sugiera tu perfil a otros fans y te incluya en la actividad de fans cercanos cuando estés activo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permet à FanGeo de suggérer votre profil à d'autres fans et de vous inclure dans l'activité des fans à proximité lorsque vous êtes actif."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consente a FanGeo di suggerire il tuo profilo ad altri fan e di includerti nell'attività dei fan nelle vicinanze quando sei attivo."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozwala FanGeo sugerować Twój profil innym fanom i uwzględniać Cię w aktywności fanów w pobliżu, gdy jesteś aktywny."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que o FanGeo sugira seu perfil a outros fãs e inclua você na atividade de fãs próximos quando estiver ativo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Позволяет FanGeo предлагать ваш профиль другим фанатам и включать вас в активность фанатов рядом, когда вы активны."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lejon FanGeo të sugjerojë profilin tënd te tifozët e tjerë dhe të të përfshijë në aktivitetin e tifozëve afër kur je aktiv."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
