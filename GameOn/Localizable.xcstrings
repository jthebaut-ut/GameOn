    "about_fangeo_independence_disclosure" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FanGeo ist eine unabhängige Fan-Plattform und nicht mit den angezeigten Teams, Ligen, Verbänden oder Wettbewerben verbunden oder von diesen empfohlen, sofern nicht ausdrücklich angegeben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FanGeo is an independent fan platform and is not affiliated with or endorsed by the teams, leagues, federations, or competitions shown unless expressly stated."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FanGeo es una plataforma independiente para aficionados y no está afiliada ni respaldada por los equipos, ligas, federaciones o competiciones mostrados, salvo que se indique expresamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FanGeo est une plateforme indépendante pour les fans et n’est pas affiliée ni cautionnée par les équipes, ligues, fédérations ou compétitions affichées, sauf mention expresse."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FanGeo è una piattaforma indipendente per i tifosi e non è affiliata né sostenuta dalle squadre, leghe, federazioni o competizioni mostrate, salvo diversa indicazione espressa."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FanGeo to niezależna platforma dla fanów i nie jest powiązana ani wspierana przez wyświetlane drużyny, ligi, federacje ani rozgrywki, chyba że wyraźnie wskazano inaczej."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O FanGeo é uma plataforma independente para fãs e não é afiliado nem endossado pelas equipes, ligas, federações ou competições exibidas, salvo indicação expressa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FanGeo — независимая фанатская платформа и не аффилирована с отображаемыми командами, лигами, федерациями или соревнованиями и не поддерживается ими, если иное прямо не указано."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FanGeo është një platformë e pavarur për tifozët dhe nuk është e afiluar as e mbështetur nga ekipet, ligat, federatat apo konkurrimet e shfaqura, përveçse kur thuhet shprehimisht."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FanGeo 是独立的球迷平台，除非另有明确说明，与所示球队、联赛、联合会或赛事无关，也未获其背书。"
          }
        }
      }
    },
