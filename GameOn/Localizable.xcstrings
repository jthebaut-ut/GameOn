    "Automatically sync your FanGeo games and events with your Apple Calendar. Calendar reminders are managed by Apple Calendar, not FanGeo notifications." : {
      "comment" : "A description of how calendar integration works.",
      "extractionState" : "manual",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronisieren Sie Ihre FanGeo Spiele und Ereignisse automatisch mit Ihrem Apple Kalender. Kalendererinnerungen werden vom Apple Kalender verwaltet, nicht von FanGeo Benachrichtigungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatically sync your FanGeo games and events with your Apple Calendar. Calendar reminders are managed by Apple Calendar, not FanGeo notifications."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincroniza automáticamente tus juegos y eventos FanGeo con tu calendario Apple. Los recordatorios del calendario son administrados por Apple Calendar, no por las notificaciones FanGeo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronisez automatiquement vos jeux et événements FanGeo avec votre calendrier Apple. Les rappels de calendrier sont gérés par Apple Calendrier, et non par les notifications FanGeo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincronizza automaticamente i tuoi giochi ed eventi FanGeo con il tuo calendario Apple. I promemoria del calendario sono gestiti da Apple Calendar, non dalle notifiche FanGeo."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatycznie synchronizuj swoje gry i wydarzenia FanGeo z kalendarzem Apple. Przypomnieniami kalendarza zarządza Kalendarz Apple, a nie powiadomienia FanGeo."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincronize automaticamente seus jogos e eventos FanGeo com seu calendário Apple. Os lembretes do calendário são gerenciados pelo Apple Calendário, não pelas notificações do FanGeo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Автоматически синхронизируйте игры и события FanGeo с календарем Apple. Напоминаниями календаря управляет Apple Calendar, а не уведомления FanGeo."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinkronizoni automatikisht lojërat dhe ngjarjet tuaja FanGeo me kalendarin tuaj Apple. Përkujtuesit e kalendarit menaxhohen nga Apple Kalendari, jo nga njoftimet FanGeo."
