    "profile_discovery_help_footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst die Profilentdeckung jederzeit ein- oder ausschalten. Ausschalten entfernt dein Profil aus FanGeo-Empfehlungen und der Nahbereichsentdeckung, entfernt aber keine bestehenden Freunde."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can turn Profile Discovery on or off at any time. Turning it off removes your profile from FanGeo recommendations and nearby discovery, but does not remove existing friends."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes activar o desactivar Descubrimiento de perfil en cualquier momento. Desactivarlo quita tu perfil de las recomendaciones y del descubrimiento cercano de FanGeo, pero no elimina a tus amigos actuales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez activer ou désactiver la Découverte de profil à tout moment. La désactiver retire votre profil des recommandations et de la découverte à proximité FanGeo, sans supprimer vos amis existants."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi attivare o disattivare la Scoperta del profilo in qualsiasi momento. Disattivarla rimuove il tuo profilo dai consigli e dalla scoperta nelle vicinanze di FanGeo, ma non rimuove gli amici esistenti."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Możesz włączać i wyłączać Odkrywanie profilu w dowolnym momencie. Wyłączenie usuwa Twój profil z rekomendacji i odkrywania w pobliżu FanGeo, ale nie usuwa istniejących znajomych."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode ativar ou desativar a Descoberta de perfil a qualquer momento. Desativá-la remove seu perfil das recomendações e da descoberta próxima do FanGeo, mas não remove amigos existentes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы можете включать и выключать обнаружение профиля в любое время. Выключение убирает профиль из рекомендаций и поиска рядом в FanGeo, но не удаляет существующих друзей."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mund ta ndezësh ose fikësh Zbulimin e profilit në çdo kohë. Fikja e heq profilin tënd nga rekomandimet dhe zbulimi afër i FanGeo, por nuk i heq miqtë ekzistues."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你可以随时开启或关闭个人资料发现。关闭后，你的个人资料会从 FanGeo 推荐和附近发现中移除，但不会删除现有好友。"
          }
        }
      }
    },
    "profile_discovery_help_intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass neue Fans dich unter Vorgeschlagenen Fans und in der Nähe finden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Let new fans find you in Suggested Fans and Nearby."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que nuevos fans te encuentren en Fans sugeridos y Cerca de ti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laissez de nouveaux fans vous trouver dans Fans suggérés et À proximité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lascia che nuovi fan ti trovino in Fan consigliati e Nelle vicinanze."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozwól nowym fanom znaleźć Cię w Sugerowanych fanach i w pobliżu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permita que novos fãs o encontrem em Fãs sugeridos e Perto de si."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Позвольте новым фанатам находить вас в «Рекомендуемых» и «Рядом»."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lejo që tifozët e rinj të të gjejnë te Tifozët e sugjeruar dhe Afër."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
