    "Your request was sent. FanGeo Support will review it. If we need more details, a support chat will appear here." : {
      "comment" : "A message displayed after a support ticket is created.",
      "extractionState" : "manual",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Anfrage wurde gesendet. FanGeo Der Support wird es überprüfen. Wenn wir weitere Details benötigen, wird hier ein Support-Chat angezeigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your request was sent. FanGeo Support will review it. If we need more details, a support chat will appear here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su solicitud fue enviada. FanGeo El soporte lo revisará. Si necesitamos más detalles, aparecerá un chat de soporte aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre demande a été envoyée. FanGeo Le support l'examinera. Si nous avons besoin de plus de détails, un chat d'support apparaîtra ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua richiesta è stata inviata. FanGeo Il supporto lo esaminerà. Se abbiamo bisogno di maggiori dettagli, qui apparirà una chat di supporto."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoja prośba została wysłana. FanGeo wsparcie to sprawdzi. Jeśli będziemy potrzebować więcej szczegółów, tutaj pojawi się czat pomocy technicznej."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua solicitação foi enviada. FanGeo O suporte irá revisá-lo. Se precisarmos de mais detalhes, um chat de suporte aparecerá aqui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш запрос отправлен. FanGeo Служба поддержки рассмотрит его. Если нам понадобится дополнительная информация, здесь появится чат поддержки."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kërkesa juaj u dërgua. FanGeo Mbështetja do ta shqyrtojë atë. Nëse na duhen më shumë detaje, këtu do të shfaqet një bisedë mbështetëse."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的请求已发送。 FanGeo 支持人员将对其进行审核。如果我们需要更多详细信息，此处将显示支持聊天。"
          }
        }
      }
    },
