    "Please sign in with your FanGeo or venue account to send a support request." : {
      "comment" : "A message displayed in a form that allows a user to submit a support ticket.",
      "extractionState" : "manual",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte melden Sie sich mit Ihrem FanGeo- oder Veranstaltungsortkonto an, um eine Supportanfrage zu senden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Please sign in with your FanGeo or venue account to send a support request."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicie sesión con su FanGeo o cuenta del local para enviar una solicitud de soporte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veuillez vous connecter avec votre FanGeo ou votre compte de site pour envoyer une demande d'support."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accedi con il tuo FanGeo o con l'account della sede per inviare una richiesta di supporto."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte melden Sie sich mit Ihrem FanGeo- oder Veranstaltungsortkonto an, um eine Supportanfrage zu senden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby wysłać prośbę o pomoc, zaloguj się na swoje konto FanGeo lub konto w obiekcie."
