          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I fan possono posizionarsi più in alto se hai partecipato o interagito con le stesse partite pickup, watch party o eventi nei locali."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fani mogą zajmować wyższe miejsca, jeśli dołączyliście do tych samych gier pickup, oglądania meczów lub wydarzeń w lokalach."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
