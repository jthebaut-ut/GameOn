    "System Default follows your iPhone appearance. Light and Dark override FanGeo locally on this device." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Systemstandard folgt Ihrem iPhone-Erscheinungsbild. Hell und Dunkel überschreiben FanGeo lokal auf diesem Gerät."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System Default follows your iPhone appearance. Light and Dark override FanGeo locally on this device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El valor predeterminado del sistema sigue la apariencia de su iPhone. La luz y la oscuridad anulan FanGeo localmente en este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les paramètres par défaut du système suivent l'apparence de votre iPhone. La lumière et l'obscurité remplacent FanGeo localement sur cet appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le impostazioni predefinite del sistema seguono l'aspetto del tuo iPhone. Chiaro e Scuro sovrascrivono FanGeo localmente su questo dispositivo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Systemstandard folgt Ihrem iPhone-Erscheinungsbild. Hell und Dunkel überschreiben FanGeo lokal auf diesem Gerät."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Domyślne ustawienia systemu odpowiadają wyglądowi Twojego iPhone'a. Jasność i Ciemność zastępują FanGeo lokalnie na tym urządzeniu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O padrão do sistema segue a aparência do seu iPhone. Claro e escuro substituem FanGeo localmente neste dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Системные настройки по умолчанию соответствуют внешнему виду вашего iPhone. Светлый и Темный параметры переопределяют FanGeo локально на этом устройстве."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parazgjedhja e sistemit ndjek pamjen tuaj të iPhone. Drita dhe errësira zëvendësojnë FanGeo në vendi në këtë pajisje."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "系统默认值遵循您的 iPhone 外观。浅色和深色在此设备上本地覆盖FanGeo。"
          }
        }
      }
    },
