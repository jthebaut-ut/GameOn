    "Paid games require an entry amount greater than zero." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für kostenpflichtige Spiele ist ein Teilnahmebetrag von mehr als Null erforderlich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paid games require an entry amount greater than zero."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los juegos pagos requieren un monto de entrada mayor que cero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les jeux payants nécessitent un montant d’entrée supérieur à zéro."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I giochi a pagamento richiedono un importo di iscrizione maggiore di zero."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für kostenpflichtige Spiele ist ein Teilnahmebetrag von mehr als Null erforderlich."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gry płatne wymagają kwoty wpisowej większej niż zero."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os jogos pagos exigem um valor de entrada superior a zero."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Платные игры требуют вступительной суммы больше нуля."
