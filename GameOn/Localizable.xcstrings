    "suggested_fans_info_privacy_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vorgeschlagene Fans nutzen datenschutzfreundliche Profil- und Aktivitätssignale. FanGeo zeigt weder den genauen Standort noch die genaue Entfernung eines anderen Fans."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suggested Fans uses privacy-safe profile and activity signals. FanGeo does not display another fan’s precise location or exact distance."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fans sugeridos usa señales de perfil y actividad respetuosas con la privacidad. FanGeo no muestra la ubicación precisa ni la distancia exacta de otro fan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fans suggérés s’appuie sur des signaux de profil et d’activité respectueux de la vie privée. FanGeo n’affiche pas la position précise ni la distance exacte d’un autre fan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fan suggeriti usa segnali di profilo e attività rispettosi della privacy. FanGeo non mostra la posizione precisa né la distanza esatta di un altro fan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sugerowani fani korzystają z bezpiecznych dla prywatności sygnałów profilu i aktywności. FanGeo nie pokazuje dokładnej lokalizacji ani dokładnej odległości innego fana."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fãs sugeridos usam sinais de perfil e atividade com privacidade. O FanGeo não exibe a localização precisa nem a distância exata de outro fã."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рекомендуемые фанаты используют безопасные для конфиденциальности сигналы профиля и активности. FanGeo не показывает точную локацию или точное расстояние другого фаната."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tifozët e sugjeruar përdorin sinjale profili dhe aktiviteti të sigurta për privatësinë. FanGeo nuk shfaq lokacionin e saktë ose distancën e saktë të një tifozi tjetër."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "推荐粉丝使用注重隐私的资料与活动信号。FanGeo 不会展示其他粉丝的精确位置或精确距离。"
          }
        }
      }
    },
