    "venue_fan_confirmations_unclaimed_note" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fan-Bestätigungen beschreiben das Erlebnis vor Ort. Sie bedeuten nicht, dass das Geschäft diesen FanGeo-Eintrag verwaltet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
