    "Upcoming and recently started listings stay here until they automatically close 12 hours after kickoff." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kommende und kürzlich begonnene Angebote bleiben hier, bis sie 12 Stunden nach dem Start automatisch geschlossen werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upcoming and recently started listings stay here until they automatically close 12 hours after kickoff."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los anuncios futuros y los iniciados recientemente permanecen aquí hasta que se cierran automáticamente 12 horas después del inicio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les annonces à venir et récemment lancées restent ici jusqu'à leur fermeture automatique 12 heures après le coup d'envoi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli elenchi imminenti e iniziati di recente rimangono qui finché non si chiudono automaticamente 12 ore dopo il kickoff."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kommende und kürzlich begonnene Angebote bleiben hier, bis sie 12 Stunden nach dem Start automatisch geschlossen werden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogłoszenia nadchodzące i niedawno rozpoczęte pozostają tutaj do momentu ich automatycznego zamknięcia po 12 godzinach od rozpoczęcia."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As listagens futuras e iniciadas recentemente permanecem aqui até fecharem automaticamente 12 horas após o início."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предстоящие и недавно запущенные объявления остаются здесь до тех пор, пока они автоматически не закроются через 12 часов после начала."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
