    "By creating an account or signing in, you agree to the FanGeo Terms of Use and Community Guidelines." : {
      "comment" : "Lead copy on the required auth terms acceptance checkbox.",
      "extractionState" : "manual",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
