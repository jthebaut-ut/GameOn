    "Deleting your FanGeo account is permanent and cannot be undone." : {
      "comment" : "A warning message for the user that deleting their account is permanent.",
      "extractionState" : "manual",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Löschen Ihres FanGeo-Kontos ist dauerhaft und kann nicht rückgängig gemacht werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deleting your FanGeo account is permanent and cannot be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La eliminación de su cuenta FanGeo es permanente y no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
