    "Send a friend request to fans, or message a business." : {
      "comment" : "A description of how to send a friend request to a user.",
      "extractionState" : "manual",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senden Sie eine Freundschaftsanfrage an Fans oder senden Sie eine Nachricht an ein Unternehmen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send a friend request to fans, or message a business."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envía una solicitud de amistad a tus fans o envía un mensaje a una empresa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoyez une demande d'amitié aux fans ou envoyez un message à une entreprise."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invia una richiesta di amicizia ai fan o invia un messaggio a un'azienda."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senden Sie eine Freundschaftsanfrage an Fans oder senden Sie eine Nachricht an ein Unternehmen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyślij zaproszenie do znajomych do fanów lub napisz do firmy."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envie um pedido de amizade aos fãs ou envie uma mensagem para uma empresa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отправьте фанатам запрос на добавление в друзья или отправьте сообщение компании."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dërgo një kërkesë për miqësi për fansat ose dërgo mesazh një biznesi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向粉丝发送好友请求，或向企业发送消息。"
          }
        }
      }
    },
