    "Drop a precise pin so fans can find this venue globally, even when the typed address is ambiguous." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geben Sie eine präzise Stecknadel ein, damit Fans diesen Veranstaltungsort weltweit finden können, auch wenn die eingegebene Adresse nicht eindeutig ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drop a precise pin so fans can find this venue globally, even when the typed address is ambiguous."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coloque un marcador preciso para que los fanáticos puedan encontrar este local en todo el mundo, incluso cuando la dirección escrita sea ambigua."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déposez une épingle précise afin que les fans puissent trouver ce lieu dans le monde entier, même lorsque l'adresse saisie est ambiguë."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inserisci un segnaposto preciso in modo che i fan possano trovare questo locale a livello globale, anche quando l'indirizzo digitato è ambiguo."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wpisz dokładną pinezkę, aby fani mogli znaleźć to miejsce na całym świecie, nawet jeśli wpisany adres jest niejednoznaczny."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coloque um alfinete preciso para que os fãs possam encontrar este local globalmente, mesmo quando o endereço digitado for ambíguo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прикрепите точный значок, чтобы фанаты могли найти это площадка по всему миру, даже если введенный адрес неоднозначен."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hidhni një kunj të saktë në mënyrë që fansat të mund ta gjejnë këtë vendi globalisht, edhe kur adresa e shtypur është e paqartë."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "留下精确的图钉，以便粉丝可以在全球范围内找到这个场地，即使输入的地址不明确。"
          }
        }
      }
