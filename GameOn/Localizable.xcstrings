    "Review finished watch parties by season and month without the noise of live fan chat." : {
      "comment" : "A description of the \"Event History\" section in the venue owner dashboard.",
      "extractionState" : "manual",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Überprüfen Sie abgeschlossene Uhrenpartys nach Saison und Monat, ohne den Lärm eines Live-Fan-Chats."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Review finished watch parties by season and month without the noise of live fan chat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revise las fiestas de visualización terminadas por temporada y mes sin el ruido del chat de fans en vivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passez en revue les soirées de visionnage terminées par saison et par mois sans le bruit du chat en direct avec les fans."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rivedi le feste finite per stagione e mese senza il rumore della chat dei fan dal vivo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Überprüfen Sie abgeschlossene Uhrenpartys nach Saison und Monat, ohne den Lärm eines Live-Fan-Chats."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przeglądaj ukończone imprezy związane z oglądaniem według sezonu i miesiąca, bez hałasu czatu z fanami na żywo."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revise as festas concluídas por temporada e mês, sem o barulho do bate-papo ao vivo dos fãs."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Просматривайте готовые вечеринки по сезонам и месяцам без шума живого чата с фанатами."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rishiko ahengjet e përfunduara të orëve sipas sezonit dhe muajit pa zhurmën e bisedës së drejtpërdrejtë me fansat."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按季节和月份查看已完成的观看派对，而无需现场粉丝聊天的噪音。"
          }
        }
      }
    },
