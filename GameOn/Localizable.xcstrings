    "FanGeo accounts are required to view details, join pickup games, save venues, and interact with events." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FanGeo-Konten sind erforderlich, um Details anzuzeigen, an Pickup-Spielen teilzunehmen, Veranstaltungsorte zu speichern und mit Veranstaltungen zu interagieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FanGeo accounts are required to view details, join pickup games, save venues, and interact with events."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se requieren cuentas FanGeo para ver detalles, unirse a juegos informales, guardar local e interactuar con eventos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les comptes FanGeo sont nécessaires pour afficher les détails, rejoindre des jeux de collecte, enregistrer des lieux et interagir avec les événements."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli account FanGeo sono necessari per visualizzare i dettagli, partecipare ai giochi di ritiro, salvare luoghi e interagire con gli eventi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FanGeo-Konten sind erforderlich, um Details anzuzeigen, an Pickup-Spielen teilzunehmen, Veranstaltungsorte zu speichern und mit Veranstaltungen zu interagieren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konta FanGeo są wymagane do przeglądania szczegółów, dołączania do gier typu pickup, zapisywania miejsc i interakcji z wydarzeniami."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As contas FanGeo são necessárias para visualizar detalhes, participar de jogos, salvar locais e interagir com eventos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Учетные записи FanGeo необходимы для просмотра подробностей, присоединения к играм, сохранения мест и взаимодействия с событиями."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Llogaritë FanGeo kërkohen për të parë detajet, për t'u bashkuar me lojërat e marrjes, për të ruajtur vendet dhe për të bashkëvepruar me ngjarjet."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FanGeo 帐户需要查看详细信息、参加临时比赛、保存场地以及与活动互动。"
          }
        }
      }
    },
