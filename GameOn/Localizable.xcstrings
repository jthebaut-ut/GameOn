    "Pickup games and meetups involve physical activity and real-world interaction. Participate at your own risk and use good judgment." : {
      "comment" : "A safety message displayed in the \"Safety\" section of the `PickupGameJoinRequestComposerSheet`.",
      "extractionState" : "manual",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei Pickup-Spielen und Meetups geht es um körperliche Aktivität und reale Interaktion. Nehmen Sie auf eigenes Risiko und mit gutem Urteilsvermögen teil."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pickup games and meetups involve physical activity and real-world interaction. Participate at your own risk and use good judgment."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los juegos para ligar y las reuniones implican actividad física e interacción con el mundo real. Participe bajo su propio riesgo y utilice su buen criterio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les jeux de ramassage et les rencontres impliquent une activité physique et une interaction dans le monde réel. Participez à vos propres risques et faites preuve de bon sens."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I giochi e gli incontri di ritiro coinvolgono l'business fisica e l'interazione nel mondo reale. Partecipa a tuo rischio e pericolo e usa il buon senso."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei Pickup-Spielen und Meetups geht es um körperliche Aktivität und reale Interaktion. Nehmen Sie auf eigenes Risiko und mit gutem Urteilsvermögen teil."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gry i spotkania związane z podrywem obejmują aktywność fizyczną i interakcję w świecie rzeczywistym. Uczestniczysz na własne ryzyko i kieruj się rozsądkiem."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jogos e encontros envolvem atividade física e interação no mundo real. Participe por sua própria conta e risco e use o bom senso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пикап-игры и встречи предполагают физическую активность и взаимодействие в реальном мире. Участвуйте на свой страх и риск и руководствуйтесь здравым смыслом."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lojërat e marrjes dhe takimet përfshijnë aktivitet fizik dhe ndërveprim në botën reale. Merrni pjesë në rrezikun tuaj dhe përdorni gjykim të mirë."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "搭讪游戏和聚会涉及身体活动和现实世界的互动。参与风险由您自己承担，并运用良好的判断力。"
          }
        }
      }
    },
