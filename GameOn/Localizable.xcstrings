    "Swipe through leagues and regions. Tap a card to add or remove a favorite." : {
      "comment" : "A description below the \"Browse teams\" header in the favorite teams picker sheet, explaining how to use it.",
      "extractionState" : "manual",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipe durch Ligen und Regionen. Tippen Sie auf eine Karte, um einen Favoriten hinzuzufügen oder zu entfernen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipe through leagues and regions. Tap a card to add or remove a favorite."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deslízate por ligas y regiones. Toque una tarjeta para agregar o eliminar un favorito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parcourez les ligues et les régions. Appuyez sur une carte pour ajouter ou supprimer un favori."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scorri i campionati e le regioni. Tocca una carta per aggiungere o rimuovere un preferito."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipe durch Ligen und Regionen. Tippen Sie auf eine Karte, um einen Favoriten hinzuzufügen oder zu entfernen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przesuwaj ligi i regiony. Kliknij kartę, aby dodać lub usunąć ulubioną."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passe pelas ligas e regiões. Toque em um cartão para adicionar ou remover um favorito."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пролистывайте лиги и регионы. Коснитесь карты, чтобы добавить или удалить избранную."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rrëshqitni nëpër liga dhe rajone. Prekni një kartë për të shtuar ose hequr një të preferuar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "滑动浏览联赛和地区。点击卡片即可添加或删除收藏夹。"
          }
        }
      }
    },
