    "Type DELETE, then tap Delete My Account. You will be signed out after deletion succeeds." : {
      "comment" : "A description of the sign-out process.",
      "extractionState" : "manual",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geben Sie LÖSCHEN ein und tippen Sie dann auf „Mein Konto löschen“. Nach erfolgreichem Löschvorgang werden Sie abgemeldet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Type DELETE, then tap Delete My Account. You will be signed out after deletion succeeds."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe ELIMINAR, luego toca Eliminar mi cuenta. Se cerrará su sesión después de que la eliminación se realice correctamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tapez SUPPRIMER, puis appuyez sur Supprimer mon compte. Vous serez déconnecté une fois la suppression réussie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digita ELIMINA, quindi tocca Elimina il mio account. Verrai disconnesso una volta completata l'eliminazione."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geben Sie LÖSCHEN ein und tippen Sie dann auf „Mein Konto löschen“. Nach erfolgreichem Löschvorgang werden Sie abgemeldet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wpisz USUŃ, a następnie stuknij opcję Usuń moje konto. Po pomyślnym usunięciu nastąpi wylogowanie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digite DELETE e toque em Excluir minha conta. Você será desconectado após a exclusão ser bem-sucedida."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Введите «УДАЛИТЬ», затем нажмите «Удалить мою учетную запись». После успешного удаления вы выйдете из системы."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shkruani DELETE, më pas prekni Fshi llogarinë time. Do të dilni pasi fshirja të ketë sukses."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "键入 DELETE，然后点击“删除我的帐户”。删除成功后您将退出。"
          }
        }
      }
    },
