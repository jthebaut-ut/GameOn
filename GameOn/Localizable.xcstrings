      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies unterscheidet sich von Business Pro und FanGeo+, bei denen es sich um digitale Abonnements handelt, die über Apple In-App-Kauf erworben werden, sofern verfügbar. Durch Werbung werden keine Premium-App-Funktionen freigeschaltet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is separate from Business Pro and FanGeo+, which are digital subscriptions purchased through Apple In-App Purchase when available. Advertising does not unlock premium app features."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto es independiente de Business Pro y FanGeo+, que son suscripciones digitales compradas a través de Apple Compra dentro de la aplicación cuando esté disponible. La publicidad no desbloquea las funciones premium de la aplicación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ceci est distinct de Business Pro et FanGeo+, qui sont des abonnements numériques achetés via Apple In-App Purchase lorsqu'ils sont disponibles. La publicité ne débloque pas les fonctionnalités des applications premium."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo è separato da Business Pro e FanGeo+, che sono abbonamenti digitali acquistati tramite Apple Acquisto in-app quando disponibile. La pubblicità non sblocca le funzionalità premium dell'app."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies unterscheidet sich von Business Pro und FanGeo+, bei denen es sich um digitale Abonnements handelt, die über Apple In-App-Kauf erworben werden, sofern verfügbar. Durch Werbung werden keine Premium-App-Funktionen freigeschaltet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Różni się to od Business Pro i FanGeo+, które są subskrypcjami cyfrowymi kupowanymi za pośrednictwem zakupów w aplikacji Apple, jeśli są dostępne. Reklamy nie odblokowują funkcji premium aplikacji."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso é separado de Business Pro e FanGeo+, que são assinaturas digitais adquiridas por meio de compra no aplicativo Apple, quando disponível. A publicidade não desbloqueia recursos premium do aplicativo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это отдельно от Business Pro и FanGeo+, которые представляют собой цифровые подписки, приобретаемые через Apple Покупки в приложении, если они доступны. Реклама не разблокирует премиум-функции приложения."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kjo është e ndarë nga Business Pro dhe FanGeo+, të cilat janë abonime dixhitale të blera përmes Apple Blerje brenda aplikacionit kur ofrohet. Reklamimi nuk zhbllokon veçoritë e aplikacionit premium."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这与Business Pro 和FanGeo+ 是分开的，Business Pro 和FanGeo+ 是通过Apple 应用内购买（如果可用）购买的数字订阅。广告不会解锁高级应用程序功能。"
          }
        }
      }
    },
