            "value" : "该名称和@handle代表您的企业帐户。场地名称单独编辑。"
          }
        }
      }
    },
    "This one-time choice is saved to your business account. You can upgrade to Business Pro to reactivate every approved venue." : {
      "comment" : "A footer text in the \"Active Venues\" sheet that explains the one-time nature of the choice.",
      "extractionState" : "manual",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese einmalige Auswahl wird in deinem Business-Konto gespeichert. Mit Business Pro kannst du jeden genehmigten Standort reaktivieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This one-time choice is saved to your business account. You can upgrade to Business Pro to reactivate every approved venue."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta elección única se guarda en tu cuenta empresarial. Puedes actualizar a Business Pro para reactivar cada local aprobado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce choix unique est enregistré sur votre compte professionnel. Passez à Business Pro pour réactiver chaque lieu approuvé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa scelta una tantum viene salvata nel tuo account business. Passa a Business Pro per riattivare ogni locale approvato."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese einmalige Auswahl wird in deinem Business-Konto gespeichert. Mit Business Pro kannst du jeden genehmigten Standort reaktivieren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten jednorazowy wybór jest zapisywany na koncie firmowym. Ulepsz do Business Pro, aby reaktywować każde zatwierdzone miejsce."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta escolha única é salva na sua conta empresarial. Faça upgrade para Business Pro para reativar cada local aprovado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот разовый выбор сохраняется в бизнес-аккаунте. Перейдите на Business Pro, чтобы реактивировать каждую одобренную площадку."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kjo zgjedhje njëherëshe ruhet në llogarinë e biznesit. Përmirëso në Business Pro për të riaktivizuar çdo vend të miratuar."
          }
        },
        "zh-Hans" : {
