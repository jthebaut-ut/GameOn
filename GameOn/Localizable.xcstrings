    "suggested_fans_info_signal_activity" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fans können höher rangieren, wenn ihr dieselben Pickup-Spiele, Watch Partys oder Venue-Events geteilt habt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fans may rank higher when you have joined or interacted with the same pickup games, watch parties, or venue events."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los fans pueden rankear más alto si has unido o interactuado con los mismos partidos pickup, watch parties o eventos de sedes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
