    "The fan may have turned off discoverability or this profile can't be shown." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Möglicherweise hat der Lüfter die Erkennbarkeit deaktiviert oder dieses Profil kann nicht angezeigt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
