    },
    "You can edit the venue name and profile details, but contact FanGeo Support to change address or core location details." : {
      "comment" : "A description of how to change the address or location of a venue.",
      "extractionState" : "manual",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie können den Namen des Veranstaltungsorts und die Profildetails bearbeiten. Wenden Sie sich jedoch an den FanGeo-Support, um die Adresse oder die Hauptstandortdetails zu ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can edit the venue name and profile details, but contact FanGeo Support to change address or core location details."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puede editar el nombre del local y los detalles del perfil, pero comuníquese con FanGeo soporte para cambiar la dirección o los detalles de la ubicación principal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez modifier le nom du lieu et les détails du profil, mais contactez le support FanGeo pour modifier l'adresse ou les détails de l'emplacement principal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi modificare il nome della sede e i dettagli del profilo, ma contatta l'supporto FanGeo per modificare l'indirizzo o i dettagli della posizione principale."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Możesz edytować nazwę miejsca i szczegóły profilu, ale skontaktuj się z działem wsparcia FanGeo, aby zmienić adres lub szczegóły lokalizacji głównej."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode editar o nome do local e os detalhes do perfil, mas entre em contato com o suporte FanGeo para alterar o endereço ou os detalhes do local principal."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы можете редактировать название заведения и данные профиля, но обратитесь в службу поддержки FanGeo, чтобы изменить адрес или данные основного местоположения."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mund të modifikoni emrin e vendit dhe detajet e profilit, por kontaktoni FanGeo Mbështetjen për të ndryshuar adresën ose detajet kryesore të vendndodhjes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您可以编辑场地名称和个人资料详细信息，但请联系 FanGeo 支持人员更改地址或核心位置详细信息。"
          }
        }
      }
    },
