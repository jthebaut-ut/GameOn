    "guide_profile_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passe dein Profil an, wähle Lieblingsteams, vernetze dich mit lokalen Fans und zeige, wen du unterstützt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Customize your profile, choose your favorite teams, connect with local fans, and show who you support."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personaliza tu perfil, elige tus equipos favoritos, conéctate con fans locales y muestra a quién apoyas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personnalise ton profil, choisis tes équipes préférées, connecte-toi avec des fans locaux et montre qui tu soutiens."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personalizza il profilo, scegli le squadre preferite, connettiti con i fan locali e mostra chi tifi."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostosuj profil, wybierz ulubione drużyny, łącz się z lokalnymi fanami i pokaż, kogo wspierasz."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personalize seu perfil, escolha seus times favoritos, conecte-se com fãs locais e mostre quem você torce."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настрой профиль, выбери любимые команды, знакомься с местными фанатами и покажи, кого поддерживаешь."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personalizo profilin, zgjidh ekipet e preferuara, lidhu me fans lokalë dhe trego kë mbështet."
