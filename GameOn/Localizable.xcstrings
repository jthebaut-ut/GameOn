    "Business-created venues will be permanently deleted. Community venues you claimed will stay on the map but will be removed from your business and returned to the FanGeo community marketplace." : {
      "comment" : "A description of the deletion preview that highlights the difference between business-created and community venues.",
      "extractionState" : "manual",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Von Unternehmen erstellte Veranstaltungsorte werden dauerhaft gelöscht. Von Ihnen beanspruchte Community-Veranstaltungsorte bleiben auf der Karte, werden jedoch aus Ihrem Unternehmen entfernt und an den FanGeo Community-Marktplatz zurückgegeben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Business-created venues will be permanently deleted. Community venues you claimed will stay on the map but will be removed from your business and returned to the FanGeo community marketplace."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los local creados por empresas se eliminarán permanentemente. Los local comunitarios que hayas reclamado permanecerán en el mapa, pero se eliminarán de tu negocio y se devolverán al mercado comunitario FanGeo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les lieux créés par les entreprise seront définitivement supprimés. Les lieux communautaires que vous avez revendiqués resteront sur la carte mais seront supprimés de votre entreprise et renvoyés sur le marché communautaire FanGeo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le sedi create dall'azienda verranno eliminate definitivamente. I luoghi della comunità che hai rivendicato rimarranno sulla mappa ma verranno rimossi dalla tua business e restituiti al mercato della comunità FanGeo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Von Unternehmen erstellte Veranstaltungsorte werden dauerhaft gelöscht. Von Ihnen beanspruchte Community-Veranstaltungsorte bleiben auf der Karte, werden jedoch aus Ihrem Unternehmen entfernt und an den FanGeo Community-Marktplatz zurückgegeben."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lokale utworzone przez firmę zostaną trwale usunięte. Lokale społecznościowe, które zgłosiłeś, pozostaną na mapie, ale zostaną usunięte z Twojej firmy i zwrócone na rynek społeczności FanGeo."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os locais criados por empresas serão excluídos permanentemente. Os locais da comunidade que você reivindicou permanecerão no mapa, mas serão removidos do seu negócio e devolvidos ao mercado da comunidade FanGeo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Площадки, созданные бизнесом, будут удалены навсегда. Заявленные вами общественные заведения останутся на карте, но будут удалены из вашего бизнеса и возвращены на торговую площадку сообщества FanGeo."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vendet e krijuara nga biznesi do të fshihen përgjithmonë. Vendet e komunitetit që pretenduat do të qëndrojnë në hartë, por do të hiqen nga biznesi juaj dhe do të kthehen në tregun e komunitetit FanGeo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "企业自建场所将被永久删除。您声称的社区场所将保留在地图上，但将从您的业务中删除并返回到 FanGeo 社区市场。"
          }
        }
      }
    },
