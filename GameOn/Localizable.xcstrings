    "Couldn’t load cycle games. Your usage count is still available above." : {
      "comment" : "Text displayed when an error occurs while loading hosted game data.",
      "extractionState" : "manual",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zyklusspiele konnten nicht geladen werden. Ihre Nutzungsanzahl ist weiterhin oben verfügbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn’t load cycle games. Your usage count is still available above."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron cargar los juegos de ciclo. Su recuento de uso todavía está disponible arriba."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de charger les jeux de cycle. Votre nombre d'utilisations est toujours disponible ci-dessus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile caricare i giochi in bicicletta. Il conteggio dell'utilizzo è ancora disponibile sopra."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zyklusspiele konnten nicht geladen werden. Ihre Nutzungsanzahl ist weiterhin oben verfügbar."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się wczytać gier cyklicznych. Twój licznik użycia jest nadal dostępny powyżej."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível carregar jogos de ciclo. Sua contagem de uso ainda está disponível acima."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось загрузить циклические игры. Ваш счетчик использования по-прежнему доступен выше."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lojërat e ciklit nuk mund të ngarkoheshin. Numri juaj i përdorimit është ende i disponueshëm më lart."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法加载循环游戏。您的使用计数仍可在上方查看。"
          }
        }
      }
    },
