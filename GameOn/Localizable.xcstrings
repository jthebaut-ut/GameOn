    "Unable to send your advertising inquiry right now. Please try again later." : {
      "comment" : "A message displayed when the user is unable to send their inquiry.",
      "extractionState" : "manual",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Werbeanfrage kann derzeit nicht gesendet werden. Bitte versuchen Sie es später noch einmal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unable to send your advertising inquiry right now. Please try again later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede enviar su consulta publicitaria en este momento. Inténtelo de nuevo más tarde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d'envoyer votre demande de publicité pour le moment. Veuillez réessayer plus tard."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile inviare la tua richiesta pubblicitaria in questo momento. Per favore riprova più tardi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Werbeanfrage kann derzeit nicht gesendet werden. Bitte versuchen Sie es später noch einmal."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W tej chwili nie można wysłać zapytania dotyczącego reklamy. Spróbuj ponownie później."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não é possível enviar sua consulta de publicidade no momento. Por favor, tente novamente mais tarde."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сейчас невозможно отправить запрос на рекламу. Пожалуйста, повторите попытку позже."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuk mund të dërgoni kërkesën tuaj për reklamat për momentin. Ju lutemi provoni përsëri më vonë."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前无法发送您的广告查询。请稍后重试。"
          }
        }
      }
    },
