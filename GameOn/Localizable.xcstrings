    "fan_activity_help_footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bestimmst, wer deine Fan-Aktivität sehen kann. Du kannst das jederzeit ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You control who can see your Fan Activity. You can change this at any time."
