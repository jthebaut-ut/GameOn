        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы решаете, кто видит вашу фанатскую активность. Это можно изменить в любое время."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti kontrollon kush mund të shohë aktivitetin tënd të tifozit. Mund ta ndryshosh në çdo kohë."
