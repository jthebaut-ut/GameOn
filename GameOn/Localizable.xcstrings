      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie haben das Limit für gehostete Spiele erreicht. Upgrade auf FanGeo Pro für unbegrenzte Spiele oder warten Sie auf die nächste Zurücksetzung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You’ve reached your hosted game cycle limit. Upgrade to FanGeo Pro for unlimited hosted games, or wait until your next reset."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Has alcanzado el límite del ciclo de partidos organizados. Actualiza a FanGeo Pro para partidos ilimitados o espera al próximo reinicio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
