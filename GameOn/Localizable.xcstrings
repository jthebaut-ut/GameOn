    "This name and @handle represent your business account. Venue names are edited separately." : {
      "comment" : "A description of the user's public business identity.",
      "extractionState" : "manual",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Name und @handle repräsentieren Ihr Geschäftskonto. Veranstaltungsortnamen werden separat bearbeitet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This name and @handle represent your business account. Venue names are edited separately."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este nombre y @handle representan su cuenta comercial. Los nombres de los local se editan por separado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce nom et @handle représentent votre compte professionnel. Les noms des lieux sont édités séparément."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo nome e @handle rappresentano il tuo account aziendale. I nomi delle sedi vengono modificati separatamente."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This name and @handle represent your business account. Venue names are edited separately."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta nazwa i @handle reprezentują Twoje konto firmowe. Nazwy miejsc są edytowane osobno."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este nome e @handle representam sua conta comercial. Os nomes dos locais são editados separadamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это имя и @handle представляют ваш бизнес-аккаунт. Названия площадок редактируются отдельно."
