    "Your venue claim is being reviewed. Venue tools unlock once a venue is approved." : {
      "comment" : "A description of the venue review process.",
      "extractionState" : "manual",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr Anspruch auf Veranstaltungsort wird geprüft. Veranstaltungsort-Tools werden freigeschaltet, sobald ein Veranstaltungsort genehmigt wurde."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your venue claim is being reviewed. Venue tools unlock once a venue is approved."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se está revisando su reclamo de sede. Las herramientas del local se desbloquean una vez que se aprueba el local."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre réclamation de lieu est en cours d'examen. Les outils du site se déverrouillent une fois qu'un lieu est approuvé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua richiesta di sede è in fase di revisione. Gli strumenti della sede si sbloccano una volta approvata la sede."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr Anspruch auf Veranstaltungsort wird geprüft. Veranstaltungsort-Tools werden freigeschaltet, sobald ein Veranstaltungsort genehmigt wurde."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje zgłoszenie dotyczące obiektu jest sprawdzane. Narzędzia dotyczące obiektów odblokowują się po zatwierdzeniu miejsca."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua reivindicação de local está sendo analisada. As ferramentas do local são desbloqueadas assim que o local é aprovado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваша заявка на площадка проведения находится на рассмотрении. Инструменты места проведения разблокируются после утверждения места проведения."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pretendimi juaj për vendin e ngjarjes po shqyrtohet. Mjetet e vendit të ngjarjes hapen pasi të miratohet një vendi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的场地申请正在审核中。一旦场地获得批准，场地工具就会解锁。"
          }
        }
      }
    },
