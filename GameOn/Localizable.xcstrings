    "business_account_deleted_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses FanGeo-Business-Konto wurde dauerhaft gelöscht und kann nicht verwendet werden. Für eine Reaktivierung wenden Sie sich an den FanGeo-Support."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This FanGeo business account has been permanently deleted and cannot be used. To request account reactivation, contact FanGeo Support."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta cuenta empresarial de FanGeo se eliminó permanentemente y no se puede usar. Para solicitar la reactivación, contacta con el soporte de FanGeo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce compte professionnel FanGeo a été définitivement supprimé et ne peut pas être utilisé. Pour demander une réactivation, contactez le support FanGeo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo account business FanGeo è stato eliminato definitivamente e non può essere usato. Per richiedere la riattivazione, contatta il supporto FanGeo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses FanGeo-Business-Konto wurde dauerhaft gelöscht und kann nicht verwendet werden. Für eine Reaktivierung wenden Sie sich an den FanGeo-Support."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To konto firmowe FanGeo zostało trwale usunięte i nie można go używać. Aby poprosić o reaktywację, skontaktuj się z pomocą FanGeo."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta conta empresarial do FanGeo foi excluída permanentemente e não pode ser usada. Para solicitar reativação, entre em contato com o suporte FanGeo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот бизнес-аккаунт FanGeo был безвозвратно удалён и не может использоваться. Чтобы запросить повторную активацию, обратитесь в поддержку FanGeo."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kjo llogari biznesi FanGeo është fshirë përgjithmonë dhe nuk mund të përdoret. Për të kërkuar riaktivizim, kontaktoni mbështetjen FanGeo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 FanGeo 企业账户已被永久删除，无法使用。如需申请重新激活，请联系 FanGeo 支持。"
          }
        }
      }
