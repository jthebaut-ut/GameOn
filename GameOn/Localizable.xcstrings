        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso é separado de Business Pro e FanGeo+, que são assinaturas digitais adquiridas por meio de compra no aplicativo Apple, quando disponível. A publicidade não desbloqueia recursos premium do aplicativo."
