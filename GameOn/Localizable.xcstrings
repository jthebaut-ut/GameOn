    "guide_welcome_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FanGeo ist die All-in-one-Sport-Community, in der Fans Sportbars, Watch Parties, Pickup-Spiele, Live-Scores und lokale Sport-Communities entdecken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FanGeo is the all-in-one sports community where fans discover sports bars, watch parties, pickup games, live scores, and local sports communities."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FanGeo es la comunidad deportiva todo en uno donde los fans descubren bares deportivos, watch parties, partidos de pickup, marcadores en vivo y comunidades locales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FanGeo est la communauté sportive tout-en-un où les fans découvrent des bars sportifs, des watch parties, des matchs pickup, des scores en direct et des communautés locales."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FanGeo è la community sportiva completa dove i fan scoprono sports bar, watch party, partite pickup, score in diretta e community locali."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FanGeo to kompleksowa społeczność sportowa, w której fani odkrywają bary sportowe, watch party, mecze pickup, wyniki na żywo i lokalne społeczności."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O FanGeo é a comunidade esportiva completa onde os fãs descobrem bars esportivos, watch parties, peladas, placares ao vivo e comunidades locais."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FanGeo — универсальное спортивное сообщество, где фанаты находят спортбары, вотч-пати, любительские игры, live-счёт и локальные сообщества."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FanGeo është komuniteti i plotë sportiv ku fansat zbulojnë bare sportive, watch parties, ndeshje pickup, rezultate live dhe komunitete lokale."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FanGeo 是一站式体育社区，球迷可发现体育酒吧、观赛派对、业余比赛、实时比分和本地体育圈子。"
          }
        }
      }
    },
