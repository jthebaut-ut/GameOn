          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osiągnięto limit cyklu organizowanych meczów. Przejdź na FanGeo Pro, aby mieć nieograniczoną liczbę meczów, lub poczekaj na następny reset."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você atingiu o limite do ciclo de jogos organizados. Atualize para o FanGeo Pro para jogos ilimitados ou aguarde a próxima redefinição."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы достигли лимита цикла проводимых игр. Перейдите на FanGeo Pro для неограниченного числа игр или дождитесь следующего сброса."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keni arritur kufirin e ciklit të ndeshjeve të organizuara. Përmirësoni në FanGeo Pro për ndeshje të pakufizuara ose prisni rivendosjen e ardhshme."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
