    "They will be removed from your friends list. You can send a new request later." : {
      "comment" : "A message displayed in a confirmation alert when unfriending a user.",
      "extractionState" : "manual",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie werden aus Ihrer Freundesliste entfernt. Sie können später eine neue Anfrage senden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They will be removed from your friends list. You can send a new request later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serán eliminados de tu lista de amigos. Puede enviar una nueva solicitud más tarde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ils seront supprimés de votre liste d'amis. Vous pourrez envoyer une nouvelle demande ultérieurement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verranno rimossi dal tuo elenco di amici. Potrai inviare una nuova richiesta in seguito."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie werden aus Ihrer Freundesliste entfernt. Sie können später eine neue Anfrage senden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zostaną usunięci z Twojej listy znajomych. Możesz wysłać nową prośbę później."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eles serão removidos da sua lista de amigos. Você pode enviar uma nova solicitação mais tarde."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Они будут удалены из вашего списка друзей. Вы можете отправить новый запрос позже."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ata do të hiqen nga lista juaj e miqve. Ju mund të dërgoni një kërkesë të re më vonë."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "他们将从您的好友列表中删除。您可以稍后发送新请求。"
          }
        }
      }
    },
    "They won't be able to message you or send friend requests. You won't see each other in chat lists while the block is active." : {
      "comment" : "A message displayed in a confirmation dialog when blocking a user.",
      "extractionState" : "manual",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie können Ihnen keine Nachrichten senden oder Freundschaftsanfragen senden. Während die Sperre aktiv ist, werden Sie sich in den Chatlisten nicht sehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They won't be able to message you or send friend requests. You won't see each other in chat lists while the block is active."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No podrán enviarte mensajes ni enviarte solicitudes de amistad. No se verán en las listas de chat mientras el bloqueo esté activo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ils ne pourront pas vous envoyer de messages ni vous envoyer de demandes d'amitié. Vous ne vous verrez pas dans les listes de discussion tant que le blocage est actif."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non potranno inviarti messaggi o inviare richieste di amicizia. Non vi vedrete negli elenchi delle chat mentre il blocco è attivo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie können Ihnen keine Nachrichten senden oder Freundschaftsanfragen senden. Während die Sperre aktiv ist, werden Sie sich in den Chatlisten nicht sehen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie będą mogli wysyłać Ci wiadomości ani zaproszeń do grona znajomych. Nie będziecie się widzieć na listach czatów, gdy blokada będzie aktywna."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eles não poderão enviar mensagens para você ou enviar solicitações de amizade. Vocês não se verão nas listas de bate-papo enquanto o bloqueio estiver ativo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Они не смогут отправлять вам сообщения или отправлять запросы на добавление в друзья. Вы не увидите друг друга в списках чатов, пока блок активен."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ata nuk do të jenë në gjendje të të dërgojnë mesazhe ose të dërgojnë kërkesa për miqësi. Nuk do ta shihni njëri-tjetrin në listat e bisedave ndërsa bllokimi është aktiv."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "他们将无法向您发送消息或发送好友请求。当屏蔽处于活动状态时，您将不会在聊天列表中看到对方。"
          }
        }
      }
    },
