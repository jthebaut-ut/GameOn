    "Get kickoff, score, and final alerts for games involving your favorite teams." : {
      "comment" : "A description of the Team Alerts feature.",
      "extractionState" : "manual",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhalten Sie Anstoß-, Spielstand- und Endbenachrichtigungen für Spiele, an denen Ihre Lieblingsmannschaften beteiligt sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Get kickoff, score, and final alerts for games involving your favorite teams."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recibe alertas de inicio, puntaje y final de juegos que involucran a tus equipos favoritos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recevez des alertes de coup d'envoi, de score et de finale pour les matchs impliquant vos équipes préférées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ricevi avvisi su calcio d'inizio, punteggio e finale per le partite che coinvolgono le tue squadre preferite."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhalten Sie Anstoß-, Spielstand- und Endbenachrichtigungen für Spiele, an denen Ihre Lieblingsmannschaften beteiligt sind."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otrzymuj powiadomienia o rozpoczęciu, wynikach i końcowych meczach z udziałem Twoich ulubionych drużyn."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Receba alertas de início, pontuação e final de jogos envolvendo seus times favoritos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Получайте оповещения о начале матча, счете и финале игр с участием ваших любимых команд."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merr sinjalizime për fillimin, rezultatin dhe finalet për lojërat që përfshijnë ekipet e tua të preferuara."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "获取涉及您最喜欢的球队的比赛的开球、得分和决赛提醒。"
          }
        }
      }
    },
