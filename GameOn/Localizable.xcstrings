    "Tell fans what you’re showing. Same details as before — saved to your venue listing." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sagen Sie den Fans, was Sie zeigen. Dieselben Details wie zuvor – in Ihrem Veranstaltungsorteintrag gespeichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tell fans what you’re showing. Same details as before — saved to your venue listing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuéntale a los fans lo que estás mostrando. Los mismos detalles que antes, guardados en la lista de local."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dites aux fans ce que vous montrez. Mêmes détails qu’avant – enregistrés dans la liste de vos lieux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Racconta ai fan cosa stai mostrando. Stessi dettagli di prima: salvati nell'elenco dei tuoi locali."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sagen Sie den Fans, was Sie zeigen. Dieselben Details wie zuvor – in Ihrem Veranstaltungsorteintrag gespeichert."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Powiedz fanom, co pokazujesz. Te same szczegóły co poprzednio — zapisane na liście obiektów."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diga aos fãs o que você está mostrando. Os mesmos detalhes de antes – salvos na lista do seu local."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Расскажите фанатам, что вы показываете. Те же данные, что и раньше — сохранены в списке ваших заведений."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tregoju fansave atë që po shfaq. Të njëjtat detaje si më parë - ruhen në listën tuaj të vendit të ngjarjes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "告诉粉丝你正在展示什么。与以前相同的详细信息 - 保存到您的场地列表中。"
          }
        }
      }
    },
