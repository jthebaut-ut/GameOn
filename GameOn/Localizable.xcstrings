          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos números muestran cuántos fans confirmaron cada característica del local. No representan la cantidad de asientos, TVs, altavoces o personas disponibles ahora."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces chiffres indiquent combien de fans ont confirmé chaque atout du lieu. Ils ne représentent pas le nombre de places, d’écrans, d’enceintes ou de personnes disponibles actuellement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questi numeri indicano quanti tifosi hanno confermato ciascuna caratteristica del locale. Non rappresentano il numero di posti, TV, altoparlanti o persone attualmente disponibili."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te liczby pokazują, ilu fanów potwierdziło daną cechę lokalu. Nie oznaczają liczby miejsc, telewizorów, głośników ani osób dostępnych w tej chwili."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esses números mostram quantos fãs confirmaram cada recurso do local. Eles não representam a quantidade de assentos, TVs, caixas de som ou pessoas disponíveis agora."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эти числа показывают, сколько фанатов подтвердили каждую особенность места. Это не количество свободных мест, телевизоров, колонок или людей сейчас."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Këto numra tregojnë sa tifozë konfirmuan çdo tipar të vendit. Nuk përfaqësojnë numrin e vendeve, TV-ve, altoparlantëve ose njerëzve të disponueshëm tani."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些数字表示有多少球迷确认了该场馆的各项特征。它们不代表当前可用的座位数、电视数、音箱数或人数。"
          }
        }
      }
    },
