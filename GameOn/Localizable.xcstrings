    "guide_live_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieh Live-Profi-Spiele, verfolge Scores in Echtzeit, entdecke, wo Fans sich treffen, und folge dem Geschehen live."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See live professional games, watch scores update in real time, discover where fans are gathering, and follow the action as it happens."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mira partidos profesionales en vivo, sigue los marcadores en tiempo real, descubre dónde se reúnen los fans y sigue la acción al instante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regarde des matchs pro en direct, suis les scores en temps réel, découvre où les fans se rassemblent et suis l’action au moment où elle se passe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda partite pro in diretta, segui gli score in tempo reale, scopri dove si riuniscono i fan e segui l’azione mentre avviene."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oglądaj mecze profesjonalne na żywo, śledź wyniki w czasie rzeczywistym, odkrywaj, gdzie zbierają się fani, i bądź na bieżąco."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veja jogos profissionais ao vivo, acompanhe placares em tempo real, descubra onde os fãs estão e siga a ação conforme acontece."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смотри профессиональные матчи в прямом эфире, следи за счётом в реальном времени, находи сборы фанатов и следи за событиями."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shiko ndeshje profesionale live, ndiq rezultatet në kohë reale, zbulo ku mblidhen fansat dhe ndiq aksionin sapo ndodh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "观看职业比赛直播，实时追踪比分，发现球迷聚集地，紧跟现场动态。"
          }
        }
      }
    },
