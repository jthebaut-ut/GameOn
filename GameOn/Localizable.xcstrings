    "notifications_intro_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhalte FanGeo-Benachrichtigungen zu Spielen, Teams, Watch Spots und Aktivität — auch wenn die App geschlossen ist (falls Benachrichtigungen auf deinem Gerät aktiviert sind)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Receive FanGeo notifications for games, teams, watch spots, and activity—even when the app is closed (if notifications are enabled on your device)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recibe notificaciones de FanGeo sobre partidos, equipos, watch spots y actividad, incluso con la app cerrada (si las notificaciones están activadas en tu dispositivo)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recevez des notifications FanGeo pour les matchs, équipes, watch spots et l’activité — même lorsque l’app est fermée (si les notifications sont activées sur votre appareil)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ricevi notifiche FanGeo su partite, squadre, watch spot e attività, anche a app chiusa (se le notifiche sono attive sul dispositivo)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otrzymuj powiadomienia FanGeo o meczach, drużynach, watch spotach i aktywności — nawet gdy aplikacja jest zamknięta (jeśli powiadomienia są włączone na urządzeniu)."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Receba notificações FanGeo sobre jogos, equipas, watch spots e atividade — mesmo com a app fechada (se as notificações estiverem ativadas no seu dispositivo)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Получайте уведомления FanGeo об играх, командах, watch spot’ах и активности — даже когда приложение закрыто (если уведомления включены на устройстве)."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merr njoftime FanGeo për ndeshje, ekipe, watch spots dhe aktivitet — edhe kur aplikacioni është mbyllur (nëse njoftimet janë të aktivizuara në pajisje)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接收有关比赛、球队、观赛点和动态的 FanGeo 通知——即使应用已关闭（需在设备上开启通知）。"
          }
        }
      }
    },
    "notifications_live_match_alerts_a11y_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FanGeo sendet Anpfiff-, Live-Ergebnis-, Halbzeit-/Pausen- und andere Live-Spielbenachrichtigungen für deine gespeicherten Spiele. Live-Abdeckung: Fußball, Basketball, American Football, Baseball und Hockey."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FanGeo sends kickoff, live score, halftime and intermission, and other live match alerts for your saved games. Live coverage: Soccer, Basketball, Football, Baseball, and Hockey."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FanGeo envía alertas de inicio, marcador en vivo, descanso/intermedio y otras alertas en directo de tus partidos guardados. Cobertura en vivo: fútbol, baloncesto, fútbol americano, béisbol y hockey."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FanGeo envoie des alertes de coup d’envoi, de score en direct, de mi-temps/entracte et d’autres alertes de match en direct pour vos matchs enregistrés. Couverture en direct : football, basketball, football américain, baseball et hockey."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FanGeo invia avvisi di calcio d’inizio, punteggio live, intervallo/intermissione e altri avvisi live per le partite salvate. Copertura live: calcio, basket, football, baseball e hockey."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FanGeo wysyła alerty o rozpoczęciu, wyniku na żywo, przerwie oraz inne alerty na żywo zapisanych meczów. Relacja na żywo: piłka nożna, koszykówka, futbol amerykański, baseball i hokej."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O FanGeo envia alertas de início, placar ao vivo, intervalo/intermissão e outros alertas ao vivo dos jogos salvos. Cobertura ao vivo: futebol, basquete, futebol americano, beisebol e hóquei."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FanGeo отправляет оповещения о старте, live-счёте, перерыве и другие live-оповещения по сохранённым матчам. Live-покрытие: футбол, баскетбол, американский футбол, бейсбол и хоккей."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FanGeo dërgon alarme për fillimin, rezultat live, gjysmëkohë/ndërprerje dhe alarme të tjera live për ndeshjet e ruajtura. Mbulim live: futboll, basketboll, futboll amerikan, bejsboll dhe hokej."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FanGeo 会为已保存的比赛发送开赛、实时比分、半场/中场及其他实时提醒。覆盖运动：足球、篮球、美式橄榄球、棒球和冰球。"
          }
        }
      }
    },
