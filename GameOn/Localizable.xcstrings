    "This can't be undone. You can create a new request later if you still need help." : {
      "comment" : "A message displayed when cancelling a support ticket.",
      "extractionState" : "manual",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies kann nicht rückgängig gemacht werden. Sie können später eine neue Anfrage erstellen, wenn Sie weiterhin Hilfe benötigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This can't be undone. You can create a new request later if you still need help."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto no se puede deshacer. Puede crear una nueva solicitud más tarde si aún necesita ayuda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela ne peut pas être annulé. Vous pourrez créer une nouvelle demande plus tard si vous avez encore besoin d'aide."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'operazione non può essere annullata. Puoi creare una nuova richiesta in un secondo momento se hai ancora bisogno di aiuto."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies kann nicht rückgängig gemacht werden. Sie können später eine neue Anfrage erstellen, wenn Sie weiterhin Hilfe benötigen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tego nie można cofnąć. Jeśli nadal będziesz potrzebować pomocy, możesz utworzyć nową prośbę później."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso não pode ser desfeito. Você poderá criar uma nova solicitação posteriormente se ainda precisar de ajuda."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это невозможно отменить. Вы можете создать новый запрос позже, если вам все еще нужна помощь."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kjo nuk mund të zhbëhet. Mund të krijoni një kërkesë të re më vonë nëse keni ende nevojë për ndihmë."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这无法撤消。如果您仍需要帮助，可以稍后创建新请求。"
