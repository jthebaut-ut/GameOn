    "venue_business_account_required_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur der Geschäftsinhaber oder ein autorisierter Vertreter kann diesen Ort beanspruchen. Erstellen oder melden Sie sich mit einem FanGeo-Business-Konto an, um fortzufahren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only the business owner or an authorized representative can claim this venue. You’ll need to create or sign in to a FanGeo Business account to continue."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo el dueño del negocio o un representante autorizado puede reclamar este local. Necesitas crear o iniciar sesión con una cuenta FanGeo Business para continuar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seul le propriétaire ou un représentant autorisé peut revendiquer ce lieu. Créez ou connectez-vous à un compte FanGeo Business pour continuer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo il titolare o un rappresentante autorizzato può rivendicare questo locale. Crea o accedi a un account FanGeo Business per continuare."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tylko właściciel lub upoważniony przedstawiciel może przejąć ten lokal. Aby kontynuować, utwórz lub zaloguj się na konto FanGeo Business."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Somente o dono do negócio ou um representante autorizado pode reivindicar este local. Crie ou entre em uma conta FanGeo Business para continuar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заявить это место может только владелец бизнеса или уполномоченный представитель. Создайте аккаунт FanGeo Business или войдите в него, чтобы продолжить."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vetëm pronari i biznesit ose një përfaqësues i autorizuar mund ta kërkojë këtë vend. Duhet të krijoni ose të hyni në një llogari FanGeo Business për të vazhduar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅商家所有者或授权代表可认领该场馆。请创建或登录 FanGeo Business 账户以继续。"
          }
        }
      }
    },
    "venue_claim_benefits" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beanspruchen Sie diesen Ort, um das Profil zu verwalten, Spiele und Watch Parties hinzuzufügen und lokale Fans zu erreichen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claim this venue to manage its profile, add games and watch parties, and connect with local fans."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reclama este local para gestionar su perfil, añadir partidos y ver partidos, y conectar con fans locales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
