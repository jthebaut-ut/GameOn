    "Receive FanGeo notifications for games, teams, venues, and activity—even when the app is closed (if notifications are enabled on your device)." : {
      "comment" : "A description of the functionality of the notification toggle.",
      "extractionState" : "manual",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhalten Sie FanGeo Benachrichtigungen für Spiele, Teams, Veranstaltungsorte und Aktivitäten – auch wenn die App geschlossen ist (sofern Benachrichtigungen auf Ihrem Gerät aktiviert sind)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Receive FanGeo notifications for games, teams, venues, and activity—even when the app is closed (if notifications are enabled on your device)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reciba notificaciones FanGeo de juegos, equipos, sedes y actividades, incluso cuando la aplicación esté cerrada (si las notificaciones están habilitadas en su dispositivo)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recevez des notifications FanGeo pour les jeux, les équipes, les sites et les activités, même lorsque l'application est fermée (si les notifications sont activées sur votre appareil)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ricevi notifiche FanGeo per giochi, squadre, luoghi e business, anche quando l'app è chiusa (se le notifiche sono abilitate sul tuo dispositivo)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhalten Sie FanGeo Benachrichtigungen für Spiele, Teams, Veranstaltungsorte und Aktivitäten – auch wenn die App geschlossen ist (sofern Benachrichtigungen auf Ihrem Gerät aktiviert sind)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otrzymuj powiadomienia FanGeo dotyczące meczów, drużyn, obiektów i aktywności — nawet gdy aplikacja jest zamknięta (jeśli na Twoim urządzeniu są włączone powiadomienia)."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Receba notificações FanGeo de jogos, equipes, locais e atividades, mesmo quando o aplicativo estiver fechado (se as notificações estiverem ativadas no seu dispositivo)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Получайте уведомления FanGeo об играх, командах, местах проведения и активности — даже когда приложение закрыто (если уведомления включены на вашем устройстве)."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merr njoftime FanGeo për lojëra, ekipe, vendi dhe aktivitete—edhe kur aplikacioni është i mbyllur (nëse njoftimet janë të aktivizuara në pajisjen tënde)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使应用程序关闭（如果您的设备上启用了通知），也可以接收有关比赛、团队、场地和活动的 FanGeo 通知。"
          }
        }
      }
    },
