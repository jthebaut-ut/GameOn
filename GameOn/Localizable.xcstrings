    "Upgrade for insights into fan interest, engagement, and venue performance." : {
      "comment" : "A description of the benefits of upgrading to the Business Statistics Pro plan.",
      "extractionState" : "manual",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upgraden Sie, um Einblicke in das Faninteresse, das Engagement und die Leistung des Veranstaltungsortes zu erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upgrade for insights into fan interest, engagement, and venue performance."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actualice para obtener información sobre el interés de los fanáticos, la participación y el rendimiento del local."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Effectuez la mise à niveau pour obtenir des informations sur l'intérêt des fans, leur engagement et les performances des sites."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esegui l'upgrade per ottenere approfondimenti sull'interesse dei fan, sul coinvolgimento e sulle prestazioni della sede."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upgraden Sie, um Einblicke in das Faninteresse, das Engagement und die Leistung des Veranstaltungsortes zu erhalten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uaktualnij, aby uzyskać wgląd w zainteresowanie fanów, zaangażowanie i wyniki w obiekcie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atualize para obter informações sobre o interesse dos fãs, o envolvimento e o desempenho do local."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обновите версию, чтобы получить представление об интересе фанатов, их вовлеченности и эффективности площадок."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Përmirëso për njohuri mbi interesin e fansave, angazhimin dhe performancën e vendit të ngjarjes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "升级以深入了解粉丝兴趣、参与度和场地表现。"
          }
        }
      }
    },
