        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "风扇可能已关闭可发现性或无法显示此配置文件。"
          }
        }
      }
    },
    "The organizer declined this request. You can clear it from your Playing list." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
