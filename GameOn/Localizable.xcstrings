          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фанаты могут ранжироваться выше, если вы участвовали в одних и тех же любительских играх, просмотрах или событиях на площадках."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tifozët mund të renditen më lart kur keni marrë pjesë ose keni ndërvepruar me të njëjtat ndeshje pickup, watch party ose evente vendndodhjeje."
