            "value" : "Probieren Sie einen anderen Zeitraum oder eine andere Sportart aus oder wählen Sie „Alle“, um weitere Aktivitäten der Menschenmenge zu überprüfen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Try another date range or sport, or choose “All” to review more crowd activity."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pruebe con otro intervalo de fechas o deporte, o elija \"Todos\" para revisar más actividad del público."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Essayez une autre plage de dates ou un autre sport, ou choisissez « Tous » pour consulter davantage d'activités de la foule."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prova un altro intervallo di date o sport oppure scegli \"Tutti\" per esaminare più business del pubblico."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Probieren Sie einen anderen Zeitraum oder eine andere Sportart aus oder wählen Sie „Alle“, um weitere Aktivitäten der Menschenmenge zu überprüfen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wypróbuj inny zakres dat lub dyscyplinę lub wybierz „Wszystkie”, aby sprawdzić większą aktywność tłumu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Experimente outro intervalo de datas ou esporte ou escolha “Todos” para analisar mais atividades do público."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Попробуйте другой диапазон дат или вид спорта или выберите «Все», чтобы просмотреть больше активности толпы."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Provo një diapazon datash ose sport tjetër ose zgjidh \"Të gjitha\" për të rishikuar më shumë aktivitete të turmës."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尝试其他日期范围或运动，或选择“全部”以查看更多人群活动。"
          }
        }
      }
    },
