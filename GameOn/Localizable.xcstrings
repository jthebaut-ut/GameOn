    "community_verified_info_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Zahlen zeigen, wie viele Fans jedes Merkmal dieses Orts bestätigt haben. Sie stehen nicht für die Anzahl verfügbarer Sitze, TVs, Lautsprecher oder Personen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
