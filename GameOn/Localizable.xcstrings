    "suggested_fans_info_exclusions_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FanGeo schlägt keine blockierten, nicht verfügbaren, nicht entdeckbaren oder bereits verbundenen Konten vor. Verworfene Vorschläge bleiben ebenfalls ausgeblendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FanGeo does not suggest blocked, unavailable, non-discoverable, or already-connected accounts. Dismissed suggestions also stay hidden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FanGeo no sugiere cuentas bloqueadas, no disponibles, no descubribles o ya conectadas. Las sugerencias descartadas también permanecen ocultas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FanGeo ne suggère pas les comptes bloqués, indisponibles, non découvrables ou déjà connectés. Les suggestions ignorées restent également masquées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FanGeo non suggerisce account bloccati, non disponibili, non trovabili o già connessi. Anche i suggerimenti ignorati restano nascosti."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FanGeo nie sugeruje kont zablokowanych, niedostępnych, niewidocznych ani już połączonych. Odrzucone sugestie też pozostają ukryte."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O FanGeo não sugere contas bloqueadas, indisponíveis, não descobíveis ou já conectadas. Sugestões dispensadas também permanecem ocultas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FanGeo не предлагает заблокированные, недоступные, скрытые от поиска или уже связанные аккаунты. Отклонённые предложения также остаются скрытыми."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FanGeo nuk sugjeron llogari të bllokuara, të padisponueshme, të pazbulueshme ose tashmë të lidhura. Sugjerimet e hequra mbeten gjithashtu të fshehura."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FanGeo 不会建议已屏蔽、不可用、不可被发现或已建立关系的账号。已忽略的建议也会保持隐藏。"
          }
        }
      }
    },
    "suggested_fans_info_intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FanGeo empfiehlt geeignete Fans anhand gemeinsamer Sportinteressen, Aktivität, Verbindungen und – wenn verfügbar – der Nähe."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FanGeo recommends eligible fans using shared sports interests, activity, connections, and nearby location when available."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FanGeo recomienda fans elegibles según intereses deportivos compartidos, actividad, conexiones y ubicación cercana cuando esté disponible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FanGeo recommande des fans éligibles selon des intérêts sportifs partagés, l’activité, les connexions et la proximité lorsque c’est possible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FanGeo consiglia fan idonei in base a interessi sportivi condivisi, attività, connessioni e posizione nelle vicinanze quando disponibile."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FanGeo sugeruje odpowiednich fanów na podstawie wspólnych zainteresowań sportowych, aktywności, połączeń oraz – gdy to możliwe – bliskiej lokalizacji."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O FanGeo recomenda fãs elegíveis com base em interesses esportivos compartilhados, atividade, conexões e localização próxima quando disponível."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FanGeo рекомендует подходящих фанатов по общим спортивным интересам, активности, связям и — при наличии — ближайшей локации."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FanGeo rekomandon tifozë të përshtatshëm sipas interesave sportive të përbashkëta, aktivitetit, lidhjeve dhe lokacionit afër kur është i disponueshëm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FanGeo 会根据共同的体育兴趣、活跃度、社交关系，以及（在可用时）附近位置，推荐符合条件的粉丝。"
          }
        }
      }
    },
    "suggested_fans_info_nearby_exact_hidden" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein genauer Standort und die genaue Entfernung werden anderen Nutzern nicht angezeigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your exact location and exact distance are not shown to other users."
          }
