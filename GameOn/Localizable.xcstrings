    "FanGeo offers real-world venue and event advertising opportunities arranged outside the app. Share your goals and our team will reach out with options." : {
      "comment" : "A description of the venue and event advertising options available outside the app.",
      "extractionState" : "manual",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FanGeo bietet reale Werbemöglichkeiten für Veranstaltungsorte und Veranstaltungen, die außerhalb der App arrangiert werden. Teilen Sie uns Ihre Ziele mit und unser Team wird Ihnen Optionen vorschlagen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FanGeo offers real-world venue and event advertising opportunities arranged outside the app. Share your goals and our team will reach out with options."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FanGeo ofrece oportunidades de publicidad de eventos y local del mundo real organizadas fuera de la aplicación. Comparta sus objetivos y nuestro equipo le ofrecerá opciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FanGeo offre des opportunités de publicité pour des lieux et des événements du monde réel organisées en dehors de l'application. Partagez vos objectifs et notre équipe vous proposera des options."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FanGeo offre opportunità pubblicitarie per luoghi ed eventi reali organizzati al di fuori dell'app. Condividi i tuoi obiettivi e il nostro team ti fornirà le opzioni."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FanGeo bietet reale Werbemöglichkeiten für Veranstaltungsorte und Veranstaltungen, die außerhalb der App arrangiert werden. Teilen Sie uns Ihre Ziele mit und unser Team wird Ihnen Optionen vorschlagen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FanGeo oferuje możliwości reklamy miejsc i wydarzeń w świecie rzeczywistym, zorganizowanych poza aplikacją. Podziel się swoimi celami, a nasz zespół przedstawi Ci opcje."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FanGeo oferece locais do mundo real e oportunidades de publicidade de eventos organizadas fora do aplicativo. Compartilhe seus objetivos e nossa equipe fornecerá opções."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FanGeo предлагает возможности рекламы на реальных площадках и мероприятиях, организованные вне приложения. Поделитесь своими целями, и наша команда предложит варианты."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FanGeo ofron mundësi reklamimi të vendeve reale dhe ngjarjeve të rregulluara jashtë aplikacionit. Ndani qëllimet tuaja dhe ekipi ynë do të arrijë me opsione."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FanGeo 提供在应用程序之外安排的真实世界场地和活动广告机会。分享您的目标，我们的团队将提供选择。"
          }
        }
      }
    },
