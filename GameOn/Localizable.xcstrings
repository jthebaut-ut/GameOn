    "FanGeo sends kickoff, live score, halftime/intermission, and other live match alerts for your saved games." : {
      "comment" : "A description of the Live Match Alerts feature.",
      "extractionState" : "manual",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FanGeo sendet Anstoß-, Live-Ergebnis-, Halbzeit-/Pause- und andere Live-Spielbenachrichtigungen für Ihre gespeicherten Spiele."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FanGeo sends kickoff, live score, halftime/intermission, and other live match alerts for your saved games."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FanGeo envía saques de salida, resultados en vivo, medio tiempo/intermedio y otras alertas de partidos en vivo para tus juegos guardados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FanGeo envoie des alertes de coup d'envoi, de score en direct, de mi-temps/entracte et d'autres alertes de match en direct pour vos parties sauvegardées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FanGeo invia avvisi di calcio d'inizio, punteggio in tempo reale, intervallo/intervallo e altri avvisi di partite in tempo reale per le tue partite salvate."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FanGeo sendet Anstoß-, Live-Ergebnis-, Halbzeit-/Pause- und andere Live-Spielbenachrichtigungen für Ihre gespeicherten Spiele."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FanGeo wysyła powiadomienia o rozpoczęciu, wynikach na żywo, przerwie/przerwie i inne powiadomienia o meczach na żywo dla zapisanych gier."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FanGeo envia alertas de início de jogo, placar ao vivo, intervalo/intervalo e outros alertas de partida ao vivo para seus jogos salvos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FanGeo отправляет уведомления о начале матча, текущем счете, перерыве/перерыве и другие оповещения о матчах в режиме реального времени для ваших сохраненных игр."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FanGeo dërgon fillimin, rezultatin e drejtpërdrejtë, pjesën e parë/ndërprerjen dhe sinjalizimet e tjera të ndeshjeve të drejtpërdrejta për lojërat tuaja të ruajtura."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FanGeo 发送开球、实时比分、半场/中场休息以及您保存的比赛的其他实时比赛提醒。"
          }
        }
      }
    },
    "FanGeo sends match start, live score, and final score alerts for your favorite teams—even if you haven't saved the game." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
